# ---------- Dependencies + Build Stage ----------
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first for better Docker cache
COPY package*.json ./

# Use npm ci for clean, reproducible production builds
RUN npm ci

# Copy source code
COPY . .

# Vite build-time environment variables
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_RAZORPAY_KEY_ID

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_RAZORPAY_KEY_ID=$VITE_RAZORPAY_KEY_ID

# Build production bundle
RUN npm run build


# ---------- Production Stage ----------
FROM nginx:1.27-alpine AS production

# Remove default nginx static files
RUN rm -rf /usr/share/nginx/html/*

# Copy built frontend files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Run nginx on port 80
EXPOSE 80

# Healthcheck to verify nginx is serving files
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]